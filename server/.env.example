PORT=5050
MONGODB_URI=
CLIENT_URL=http://localhost:5173

# --- Authentication (Phase 2) ---

# Secret used to sign short-lived JWT access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

# Refresh sessions are opaque, DB-backed (RefreshSession) and rotated on every use.
REFRESH_TOKEN_TTL_DAYS=30

# Optional: cookie Domain attribute for the refresh-token cookie (leave empty for localhost).
COOKIE_DOMAIN=

# Verification / reset token lifetimes
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# --- Google OAuth ---
# Create OAuth 2.0 credentials in Google Cloud Console (Web application type).
# Authorized redirect URI must exactly match GOOGLE_CALLBACK_URL below.
# Google sign-in is disabled automatically (returns 501) until all three are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5050/api/auth/google/callback

# --- Email service ---
# EMAIL_MODE controls how verification and password reset emails are dispatched:
#   "development" (default for local dev) — does NOT call Resend; logs verification and
#                 password-reset URLs to the server terminal. Never allowed in production.
#   "resend"      (required for production) — sends real emails via the Resend API.
EMAIL_MODE=development

# Required when EMAIL_MODE=resend:
# Create an API key at https://resend.com and configure a verified sending domain/address.
# In local development with EMAIL_MODE=development, these can be left blank.
RESEND_API_KEY=
EMAIL_FROM=InvoiceFlow <onboarding@resend.dev>
